    if (url.includes('DigitalForecast')) return { ok: true, status: 200, text: async () => JSON.stringify(FIXTURES.digitalForecast) };
    if (url.includes('wttr.in')) return { ok: true, status: 200, text: async () => JSON.stringify(FIXTURES.wttr) };
