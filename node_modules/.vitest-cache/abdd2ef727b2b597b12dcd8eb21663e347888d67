//# 
//# vitestSourceMap={"version":3,"sources":["worker.test.mjs"],"sourcesContent":["// Worker tests — vitest. Exercises the Hono app via app.request() with an\n// in-memory stub facilitator (no network) and a fully mocked fetchImpl.\n// Fixture PDFs are built in-memory (zlib deflate = PDF FlateDecode).\nimport { describe, it, expect } from 'vitest';\nimport { deflateSync } from 'node:zlib';\nimport { createWorkerApp, workerConfig } from '../src/worker.mjs';\nimport { pdfToPages } from '../src/pdf.mjs';\nimport {\n  extractJsonFromText, findJsonCandidates, csvToJson, jsonToCsv,\n  guardUrl, verifyEmail,\n} from '../src/tools.mjs';\n\nconst SELLER = '0xAe9ad223a1D4e9ADecFd3BD8363f1b8Ea4e0d512';\nconst USDC_BASE = '0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913';\nconst PRICE = '$0.002';\nconst AMOUNT = '2000';\n\n// ------------------------------------------------------------- PDF fixtures\n\nfunction pdfEscape(s) {\n  return s.replace(/\\\\/g, '\\\\\\\\').replace(/\\(/g, '\\\\(').replace(/\\)/g, '\\\\)');\n}\n\n/** Build a minimal 2-page PDF; content streams compressed (FlateDecode). */\nfunction buildFixturePdf(pagesText, { compress = true } = {}) {\n  const objects = [];\n  const pageObjNums = [];\n  // objects: 1 = catalog, 2 = pages, 3.. = per page: (content, page)\n  let num = 3;\n  for (const text of pagesText) {\n    const contentNum = num++;\n    const pageNum = num++;\n    const lines = text.split('\\n')\n      .map((l) => `BT /F1 12 Tf 72 720 Td (${pdfEscape(l)}) Tj ET`)\n      .join('\\n');\n    const content = compress ? deflateSync(Buffer.from(lines)) : Buffer.from(lines);\n    objects[contentNum] = `${contentNum} 0 obj\\n<< /Length ${content.length} /Filter ${compress ? '/FlateDecode' : 'None'} >>\\nstream\\n${content.toString('latin1')}\\nendstream\\nendobj\\n`;\n    objects[pageNum] = `${pageNum} 0 obj\\n<< /Type /Page /Parent 2 0 R /Contents ${contentNum} 0 R >>\\nendobj\\n`;\n    pageObjNums.push(pageNum);\n  }\n  const kids = pageObjNums.map((n) => `${n} 0 R`).join(' ');\n  objects[1] = `1 0 obj\\n<< /Type /Catalog /Pages 2 0 R >>\\nendobj\\n`;\n  objects[2] = `2 0 obj\\n<< /Type /Pages /Kids [${kids}] /Count ${pageObjNums.length} >>\\nendobj\\n`;\n  let out = '%PDF-1.4\\n';\n  for (let i = 1; i < objects.length; i++) out += objects[i];\n  out += 'trailer\\n<< /Root 1 0 R >>\\n%%EOF';\n  return Buffer.from(out, 'latin1');\n}\n\nconst FIXTURE_PDF = buildFixturePdf([\n  'Invoice #2026-001',\n  'Total due: $150.00',\n], {});\nconst UNCOMPRESSED_PDF = buildFixturePdf(['Hello page one', 'Second line'], { compress: false });\n\nfunction pdfBytesResponse(bytes) {\n  return {\n    ok: true, status: 200,\n    headers: new Headers({ 'content-type': 'application/pdf' }),\n    arrayBuffer: async () => bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength),\n  };\n}\n\n// ------------------------------------------------------------------ mock fetch\n\nfunction mockFetch(overrides = {}) {\n  const calls = [];\n  const fn = async (url, init = {}) => {\n    calls.push({ url: String(url) });\n    const ov = Object.entries(overrides).find(([k]) => String(url).includes(k));\n    if (ov) {\n      if (ov[1] === 'throw') throw new Error('network unreachable');\n      if (ov[1] === 'http503') return { ok: false, status: 503, headers: new Headers(), text: async () => 'unavailable' };\n      if (ov[1] === 'pdf') return pdfBytesResponse(FIXTURE_PDF);\n    }\n    if (String(url).includes('cloudflare-dns.com/dns-query')) {\n      const name = decodeURIComponent(String(url).match(/name=([^&]+)/)?.[1] ?? '');\n      const hasMx = !name.startsWith('nomx.');\n      const body = hasMx\n        ? { Status: 0, Answer: [{ type: 15, data: '10 mx.example.com.' }] }\n        : { Status: 0, Answer: [] };\n      return {\n        ok: true, status: 200, headers: new Headers(),\n        text: async () => JSON.stringify(body), json: async () => body,\n      };\n    }\n    if (/^https?:\\/\\//.test(String(url))) return pdfBytesResponse(FIXTURE_PDF);\n    return { ok: false, status: 404, headers: new Headers(), text: async () => '{}' };\n  };\n  fn.calls = calls;\n  return fn;\n}\n\nfunction makeApp(overrides = {}, extraDeps = {}) {\n  return createWorkerApp(overrides, {\n    fetchImpl: mockFetch(),\n    facilitator: stubFacilitator(),\n    bypassHeader: 'x-test-bypass',\n    bypassValue: 'letmein',\n    ...extraDeps,\n  });\n}\n\nfunction stubFacilitator() {\n  return {\n    getSupported: async () => ({\n      kinds: [{ x402Version: 2, scheme: 'exact', network: 'eip155:8453' }],\n      extensions: [],\n    }),\n    verify: async () => ({ isValid: true, payer: '0x1234567890abcdef1234567890abcdef12345678' }),\n    settle: async () => ({ success: true, transaction: '0xdeadbeef', network: 'eip155:8453' }),\n  };\n}\n\nconst bypass = { 'x-test-bypass': 'letmein' };\n\nfunction decodePaymentHeader(res) {\n  const hdr = res.headers.get('payment-required');\n  expect(hdr).toBeTruthy();\n  const b64 = hdr.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat((4 - (hdr.length % 4)) % 4);\n  return JSON.parse(Buffer.from(b64, 'base64').toString('utf8'));\n}\n\n// ------------------------------------------------------------------- tests\n\ndescribe('free routes', () => {\n  it('GET /health → 200 with paid endpoints and $0.002 price', async () => {\n    const res = await makeApp().request('/health');\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.status).toBe('ok');\n    expect(body.price).toBe(PRICE);\n    expect(body.amount ?? undefined).toBeUndefined();\n    expect(body.network).toBe('eip155:8453');\n    expect(body.paidEndpoints).toContain('/v1/pdf2text');\n  });\n\n  it('GET /openapi.json → all paid paths with x-payment-info (payTo + price)', async () => {\n    const res = await makeApp().request('/openapi.json');\n    const body = await res.json();\n    for (const p of ['/v1/pdf2text', '/v1/extract-json', '/v1/csv2json', '/v1/json2csv', '/v1/email-verify']) {\n      expect(body.paths[p]).toBeTruthy();\n      expect(body.paths[p].post['x-payment-info'].payTo).toBe(SELLER);\n      expect(body.paths[p].post['x-payment-info'].price).toBe(PRICE);\n    }\n  });\n\n  it('GET /.well-known/x402 → manifest lists paid resources with accepts.payTo + amount 2000', async () => {\n    const res = await makeApp().request('/.well-known/x402');\n    const body = await res.json();\n    expect(body.x402Version).toBe(2);\n    const paths = body.resources.map((r) => new URL(r.resource).pathname);\n    for (const p of ['/v1/pdf2text', '/v1/extract-json', '/v1/csv2json', '/v1/json2csv', '/v1/email-verify']) {\n      expect(paths).toContain(p);\n    }\n    const acc = body.resources[0].accepts[0];\n    expect(acc.payTo).toBe(SELLER);\n    expect(acc.amount).toBe(AMOUNT);\n    expect(acc.asset).toBe(USDC_BASE);\n    expect(acc.network).toBe('eip155:8453');\n  });\n});\n\ndescribe('bare probes → 402 with payTo in header AND body', () => {\n  for (const [path, label] of [\n    ['/v1/pdf2text', 'empty body'],\n    ['/v1/extract-json', 'empty body'],\n    ['/v1/csv2json', 'empty body'],\n    ['/v1/json2csv', 'empty body'],\n    ['/v1/email-verify', 'empty body'],\n  ]) {\n    it(`POST ${path} (${label}) → 402, PAYMENT-REQUIRED header decodes to payTo`, async () => {\n      const res = await makeApp().request(path, { method: 'POST' });\n      expect(res.status).toBe(402);\n      const decoded = decodePaymentHeader(res);\n      expect(decoded.accepts[0].payTo).toBe(SELLER);\n      const body = await res.json();\n      expect(body.accepts[0].payTo).toBe(SELLER);\n      expect(body.accepts[0].amount).toBe(AMOUNT);\n      expect(res.headers.get('payment-required')).toBeTruthy();\n    });\n  }\n});\n\ndescribe('invalid params → 400 (pre-gate, before payment)', () => {\n  it('pdf2text JSON body without url → 400', async () => {\n    const res = await makeApp().request('/v1/pdf2text', {\n      method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ nope: 1 }),\n    });\n    expect(res.status).toBe(400);\n    expect((await res.json()).error).toBe('invalid_body');\n  });\n\n  it('pdf2text SSRF-guard: url=http://127.0.0.1/x.pdf → 400 blocked_target', async () => {\n    const res = await makeApp().request('/v1/pdf2text', {\n      method: 'POST', headers: { 'content-type': 'application/json' },\n      body: JSON.stringify({ url: 'http://127.0.0.1/secret.pdf' }),\n    });\n    expect(res.status).toBe(400);\n    expect((await res.json()).error).toBe('blocked_target');\n  });\n\n  it('pdf2text non-PDF bytes → 400 invalid_pdf', async () => {\n    const res = await makeApp().request('/v1/pdf2text', {\n      method: 'POST', headers: { 'content-type': 'application/octet-stream' }, body: 'not a pdf at all',\n    });\n    expect(res.status).toBe(400);\n    expect((await res.json()).error).toBe('invalid_pdf');\n  });\n\n  it('extract-json missing text → 400', async () => {\n    const res = await makeApp().request('/v1/extract-json', {\n      method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ schema: {} }),\n    });\n    expect(res.status).toBe(400);\n    expect((await res.json()).error).toBe('missing_text');\n  });\n\n  it('json2csv non-array body → 400', async () => {\n    const res = await makeApp().request('/v1/json2csv', {\n      method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ a: 1 }),\n    });\n    expect(res.status).toBe(400);\n    expect((await res.json()).error).toBe('invalid_body');\n  });\n\n  it('email-verify missing email → 400', async () => {\n    const res = await makeApp().request('/v1/email-verify', {\n      method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({}),\n    });\n    expect(res.status).toBe(400);\n    expect((await res.json()).error).toBe('missing_email');\n  });\n});\n\ndescribe('pdf2text', () => {\n  it('fixture PDF bytes (FlateDecode) → per-page text with chars', async () => {\n    const res = await makeApp().request('/v1/pdf2text', {\n      method: 'POST', headers: { ...bypass, 'content-type': 'application/pdf' }, body: FIXTURE_PDF,\n    });\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.pageCount).toBe(2);\n    expect(body.pages[0]).toEqual({ page: 1, text: 'Invoice #2026-001', chars: 17 });\n    expect(body.pages[1].text).toContain('Total due: $150.00');\n    expect(body.pages[1].chars).toBeGreaterThan(0);\n  });\n\n  it('fixture PDF via {url} (mock upstream, SSRF-safe) → same result + X-Cache', async () => {\n    const app = makeApp();\n    const res = await app.request('/v1/pdf2text', {\n      method: 'POST', headers: { ...bypass, 'content-type': 'application/json' },\n      body: JSON.stringify({ url: 'https://example.com/doc.pdf' }),\n    });\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.source).toBe('https://example.com/doc.pdf');\n    expect(body.pages.length).toBe(2);\n    const res2 = await app.request('/v1/pdf2text', {\n      method: 'POST', headers: { ...bypass, 'content-type': 'application/json' },\n      body: JSON.stringify({ url: 'https://example.com/doc.pdf' }),\n    });\n    expect(res2.headers.get('x-cache')).toBe('hit');\n  });\n\n  it('uncompressed PDF → text extracted too', async () => {\n    const res = await makeApp().request('/v1/pdf2text', {\n      method: 'POST', headers: { ...bypass, 'content-type': 'application/pdf' }, body: UNCOMPRESSED_PDF,\n    });\n    const body = await res.json();\n    expect(body.pages[0].text).toBe('Hello page one');\n  });\n\n  it('upstream PDF fetch 503 → 502 upstream_error', async () => {\n    const res = await makeApp({}, { fetchImpl: mockFetch({ 'example.com': 'http503' }) }).request('/v1/pdf2text', {\n      method: 'POST', headers: { ...bypass, 'content-type': 'application/json' },\n      body: JSON.stringify({ url: 'https://example.com/doc.pdf' }),\n    });\n    expect(res.status).toBe(502);\n    expect((await res.json()).error).toBe('upstream_error');\n  });\n\n  it('image-only (no text operators) PDF → empty page texts, honest chars=0', async () => {\n    const empty = buildFixturePdf([' ']);\n    const parsed = await pdfToPages(new Uint8Array(empty));\n    expect(parsed.pages[0].chars).toBe(0);\n  });\n});\n\ndescribe('extract-json', () => {\n  it('code-fence ```json block → parsed data', () => {\n    const out = extractJsonFromText(\n      'Sure! Here it is:\\n```json\\n{\"name\": \"Ada\", \"age\": 36}\\n```\\nHope that helps.',\n      { type: 'object', properties: { name: { type: 'string' }, age: { type: 'number' } }, required: ['name', 'age'] },\n    );\n    expect(out.data).toEqual({ name: 'Ada', age: 36 });\n    expect(out.missingRequired).toEqual([]);\n    expect(out.coerced).toEqual([]);\n    expect(out.confidence).toBe(1);\n  });\n\n  it('messy text without fences → brace-balance matching finds embedded JSON', () => {\n    const out = extractJsonFromText(\n      'The answer is {\"status\": \"ok\", \"count\": 3} as returned by the API today.',\n      { type: 'object', properties: { status: { type: 'string' }, count: { type: 'number' } } },\n    );\n    expect(out.data.status).toBe('ok');\n    expect(out.data.count).toBe(3);\n  });\n\n  it('type coercion: string \"5\" → number 5, \"true\" → true, coerced reported', () => {\n    const out = extractJsonFromText(\n      '{\"qty\": \"5\", \"active\": \"true\"}',\n      { type: 'object', properties: { qty: { type: 'number' }, active: { type: 'boolean' } } },\n    );\n    expect(out.data).toEqual({ qty: 5, active: true });\n    expect(out.coerced.length).toBe(2);\n    expect(out.coerced[0].reason).toBe('string→number');\n    expect(out.confidence).toBeLessThan(1);\n  });\n\n  it('missing required key → data without it, missingRequired listed', () => {\n    const out = extractJsonFromText(\n      '```json\\n{\"name\": \"Kim\"}\\n```',\n      { type: 'object', properties: { name: { type: 'string' }, email: { type: 'string' } }, required: ['name', 'email'] },\n    );\n    expect(out.data).toEqual({ name: 'Kim' });\n    expect(out.missingRequired).toEqual(['email']);\n    expect(out.confidence).toBe(0.8);\n  });\n\n  it('no parseable JSON in text → throws no_json_found (400)', () => {\n    expect(() => extractJsonFromText('just words, nothing here', {})).toThrowError(/No parseable JSON/);\n  });\n\n  it('nested schema: array items validated & coerced', () => {\n    const out = extractJsonFromText(\n      '{\"items\": [{\"price\": \"12.5\"}, {\"price\": \"3\"}]}',\n      { type: 'object', properties: { items: { type: 'array', items: { type: 'number' } } } },\n    );\n    expect(out.data.items).toEqual([12.5, 3]);\n    expect(out.coerced.length).toBe(2);\n  });\n\n  it('findJsonCandidates: fences first, then balanced braces honoring strings', () => {\n    const cands = findJsonCandidates('x {\"a\": \"}{\"} y');\n    expect(cands.some((c) => JSON.parse(c).a === '} {'.trim())).toBe(true);\n  });\n});\n\ndescribe('csv2json / json2csv', () => {\n  it('comma CSV with quotes → array of objects', () => {\n    const out = csvToJson('name,city\\n\"Ali, Jr\",Jakarta\\nBudi,Bandung');\n    expect(out.delimiter).toBe(',');\n    expect(out.rowCount).toBe(2);\n    expect(out.data[0]).toEqual({ name: 'Ali, Jr', city: 'Jakarta' });\n    expect(out.data[1]).toEqual({ name: 'Budi', city: 'Bandung' });\n  });\n\n  it('semicolon + pipe + tab delimiter auto-detect', () => {\n    expect(csvToJson('a;b\\n1;2').delimiter).toBe(';');\n    expect(csvToJson('a|b\\n1|2').delimiter).toBe('|');\n    expect(csvToJson('a\\tb\\n1\\t2').delimiter).toBe('\\\\t');\n  });\n\n  it('type inference: number, boolean, ISO date kept as string, null tokens', () => {\n    const out = csvToJson('id,active,due,note\\n42,true,2024-01-15,null\\n7,false,2024-02-01,-');\n    expect(out.data[0]).toEqual({ id: 42, active: true, due: '2024-01-15', note: null });\n    expect(out.data[1]).toEqual({ id: 7, active: false, due: '2024-02-01', note: null });\n  });\n\n  it('escaped quotes \"\" inside quoted field survive', () => {\n    const out = csvToJson('q\\n\"He said \"\"hi\"\"\"');\n    expect(out.data[0].q).toBe('He said \"hi\"');\n  });\n\n  it('json2csv escapes quotes, commas, newlines (RFC 4180)', () => {\n    const out = jsonToCsv([{ a: 'has,comma', b: 'has\"quote', c: 'line1\\nline2' }]);\n    expect(out.columns).toEqual(['a', 'b', 'c']);\n    const rows = out.csv.split('\\r\\n');\n    expect(rows[0]).toBe('a,b,c');\n    expect(rows[1]).toBe('\"has,comma\",\"has\"\"quote\",\"line1\\nline2\"');\n  });\n\n  it('json2csv: union of keys in first-seen order, null → empty cell', () => {\n    const out = jsonToCsv([{ x: 1 }, { y: 2, x: null }]);\n    expect(out.columns).toEqual(['x', 'y']);\n    expect(out.csv.split('\\r\\n')[2]).toBe(',2');\n  });\n\n  it('empty CSV body → throws 400', () => {\n    expect(() => csvToJson('   ')).toThrowError();\n  });\n});\n\ndescribe('email-verify', () => {\n  it('valid personal address with MX → DELIVERABLE', async () => {\n    const out = await verifyEmail('budi.santoso@example.com', mockFetch());\n    expect(out.verdict).toBe('DELIVERABLE');\n    expect(out.role).toBe(false);\n    expect(out.disposable).toBe(false);\n    expect(out.mx).toEqual(['mx.example.com']);\n  });\n\n  it('role account info@ → ROLE', async () => {\n    const out = await verifyEmail('support@example.com', mockFetch());\n    expect(out.verdict).toBe('ROLE');\n    expect(out.role).toBe(true);\n  });\n\n  it('disposable domain (hardcoded list) → RISKY', async () => {\n    const out = await verifyEmail('x@mailinator.com', mockFetch());\n    expect(out.verdict).toBe('RISKY');\n    expect(out.disposable).toBe(true);\n  });\n\n  it('invalid syntax / bad TLD → INVALID without DNS call', async () => {\n    const fetcher = mockFetch();\n    const out = await verifyEmail('not-an-email', fetcher);\n    expect(out.verdict).toBe('INVALID');\n    expect(fetcher.calls.length).toBe(0);\n  