//# vitestSourceMap={"version":3,"sources":["worker.test.mjs"],"sourcesContent":["// Compliance API tests — vitest. Exercises the Hono app via app.request()\n// with an in-memory stub facilitator (no network) and a fully mocked fetchImpl\n// serving OFAC SDN.CSV / VIES fixtures. IBAN checksums come from official\n// ISO 13616 example numbers (GB82 WEST 1234 5698 7654 32, NL91 ABNA 0417 1643 00).\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { createWorkerApp, workerConfig } from '../src/worker.mjs';\nimport {\n  parseSdnCsv, parseCsvRows, extractAliases, screenName,\n  normalizeName, levenshtein, validateIban, checkVatFormat, validateVat,\n  screenVerdict, IBAN_LENGTHS,\n} from '../src/tools.mjs';\n\nconst SELLER = '0xAe9ad223a1D4e9ADecFd3BD8363f1b8Ea4e0d512';\nconst USDC_BASE = '0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913';\nconst PRICE = '$0.004';\nconst AMOUNT = '4000';\n\nfunction stubFacilitator() {\n  return {\n    getSupported: async () => ({\n      kinds: [{ x402Version: 2, scheme: 'exact', network: 'eip155:8453' }],\n      extensions: [],\n    }),\n    verify: async () => ({ isValid: true, payer: '0x1234567890abcdef1234567890abcdef12345678' }),\n    settle: async () => ({ success: true, transaction: '0xdeadbeef', network: 'eip155:8453' }),\n  };\n}\n\n// ------------------------------------------------------------------ fixtures\n// Mirrors real SDN.CSV column layout: ent_num, SDN_Name, SDN_Type, Program,\n// Title, Call_Sign, Vess_type, Tonnage, GRT, Vess_flag, Vess_owner, Remarks.\n// (Verified against the live https://www.treasury.gov/ofac/downloads/sdn.csv\n// download — 302 → S3, ~19.6k rows, e.g. Saddam Hussein row carries program\n// IRAQ2 and \"a.k.a. 'ABU ALI'\" in Remarks.)\nconst OFAC_CSV = [\n  '36,\"AEROCARIBBEAN AIRLINES\",-0- ,\"CUBA\",-0- ,-0- ,-0- ,-0- ,-0- ,-0- ,-0- ,-0- ',\n  '7843,\"AL-TIKRITI, Saddam Hussein\",\"individual\",\"IRAQ2\",-0- ,-0- ,-0- ,-0- ,-0- ,-0- ,-0- ,\"DOB 28 Apr 1937; POB al-Awja, near Tikrit, Iraq; nationality Iraq; President since 1979; a.k.a. \\'ABU ALI\\'.\"',\n  '1234,\"BANCO NACIONAL DE CUBA\",-0- ,\"CUBA\",-0- ,-0- ,-0- ,-0- ,-0- ,-0- ,-0- ,\"a.k.a. \\'BNC\\'.\"',\n  '5678,\"PERSONA EJEMPLO\",\"individual\",\"SDGT\",-0- ,-0- ,-0- ,-0- ,-0- ,-0- ,-0- ,-0- ',\n].join('\\r\\n') + '\\r\\n';\n\nconst textResponse = (body, status = 200, headers = {}) => new Response(body, {\n  status, headers: { 'content-type': 'text/plain', ...headers },\n});\nconst jsonResponse = (obj, status = 200) => new Response(JSON.stringify(obj), {\n  status, headers: { 'content-type': 'application/json' },\n});\n\nfunction makeFetchImpl({ csv = OFAC_CSV, vies = {}, csvError = null } = {}) {\n  return async (url) => {\n    if (url.includes('sdn.csv')) {\n      if (csvError) throw new Error(csvError);\n      return textResponse(csv);\n    }\n    if (url.includes('check-vat-number')) {\n      throw new Error('unexpected direct VIES URL — validateVat uses its own fetch');\n    }\n    throw new Error(`unexpected fetch: ${url}`);\n  };\n}\n\nlet fetchCalls;\nfunction makeApp(opts = {}) {\n  const impl = opts.fetchImpl ?? makeFetchImpl(opts);\n  fetchCalls = 0;\n  const wrapped = async (...args) => { fetchCalls++; return impl(...args); };\n  return createWorkerApp(opts.config ?? {}, {\n    facilitator: stubFacilitator(),\n    fetchImpl: wrapped,\n    ...(opts.deps ?? {}),\n  });\n}\n\nconst decode402Body = async (res) => {\n  const payload = await res.json();\n  const hdr = res.headers.get('payment-required');\n  let headerPayload = null;\n  if (hdr) {\n    const b64 = hdr.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat((4 - (hdr.length % 4)) % 4);\n    headerPayload = JSON.parse(Buffer.from(b64, 'base64').toString('utf8'));\n  }\n  return { payload, headerPayload };\n};\n\nbeforeEach(() => { fetchCalls = 0; });\n\n// ------------------------------------------------------------- OFAC parsing\ndescribe('OFAC SDN parsing', () => {\n  it('parses CSV rows (quoted commas, CRLF, dash placeholders)', () => {\n    const rows = parseCsvRows(OFAC_CSV);\n    expect(rows.length).toBe(4);\n    expect(parseSdnCsv(OFAC_CSV)).toEqual([\n      { name: 'AEROCARIBBEAN AIRLINES', type: '', program: 'CUBA', aliases: [] },\n      { name: 'AL-TIKRITI, Saddam Hussein', type: 'individual', program: 'IRAQ2', aliases: ['ABU ALI'] },\n      { name: 'BANCO NACIONAL DE CUBA', type: '', program: 'CUBA', aliases: ['BNC'] },\n      { name: 'PERSONA EJEMPLO', type: 'individual', program: 'SDGT', aliases: [] },\n    ]);\n  });\n\n  it('extractAliases finds a.k.a. / f.k.a. entries', () => {\n    expect(extractAliases(\"DOB 1970; a.k.a. 'ABU ALI'; f.k.a. \\\"AL SAYED\\\"; Passport X\")).toEqual(['ABU ALI', 'AL SAYED']);\n  });\n\n  it('fuzzy match: exact name hits with score 1.0', () => {\n    const entries = parseSdnCsv(OFAC_CSV);\n    const m = screenName('AL-TIKRITI, Saddam Hussein', entries);\n    expect(m[0].name).toBe('AL-TIKRITI, Saddam Hussein');\n    expect(m[0].score).toBe(1);\n    expect(m[0].program).toBe('IRAQ2');\n    expect(m[0].type).toBe('individual');\n  });\n\n  it('fuzzy match: alias match (query by a.k.a.)', () => {\n    const m = screenName('ABU ALI', parseSdnCsv(OFAC_CSV));\n    expect(m[0].name).toBe('AL-TIKRITI, Saddam Hussein');\n    expect(m[0].score).toBeGreaterThanOrEqual(0.85);\n  });\n\n  it('fuzzy match: token-subset match for reordered tokens', () => {\n    const m = screenName('Saddam Hussein', parseSdnCsv(OFAC_CSV));\n    expect(m[0].name).toBe('AL-TIKRITI, Saddam Hussein');\n    expect(m[0].score).toBeGreaterThanOrEqual(0.85);\n  });\n\n  it('no plausible match returns empty matches', () => {\n    expect(screenName('Zzzqqq Wwrtyy', parseSdnCsv(OFAC_CSV))).toEqual([]);\n  });\n\n  it('levenshtein + normalization sanity', () => {\n    expect(levenshtein('kitten', 'sitting')).toBe(3);\n    expect(normalizeName('José-María  O.’Connor')).toBe('JOSE MARIA O CONNOR');\n  });\n});\n\n// ------------------------------------------------------------- IBAN\ndescribe('IBAN validation', () => {\n  it('registry has 80+ countries', () => {\n    expect(Object.keys(IBAN_LENGTHS).length).toBeGreaterThanOrEqual(80);\n  });\n\n  it('GB82 WEST 1234 5698 7654 32 valid (official example)', () => {\n    expect(validateIban('GB82 WEST 1234 5698 7654 32')).toEqual({\n      valid: true, country: 'GB', bankHint: 'WEST1234',\n      reason: 'format + mod-97 checksum valid',\n    });\n  });\n\n  it('NL91 ABNA 0417 1643 00 valid (official example)', () => {\n    const r = validateIban('NL91 ABNA 0417 1643 00');\n    expect(r.valid).toBe(true);\n    expect(r.country).toBe('NL');\n    expect(r.bankHint).toBe('ABNA0417');\n  });\n\n  it('checksum error → invalid with reason', () => {\n    const r = validateIban('GB83 WEST 1234 5698 7654 32');\n    expect(r.valid).toBe(false);\n    expect(r.reason).toContain('checksum_failed');\n    expect(r.country).toBe('GB');\n  });\n\n  it('bad format (too short / illegal chars) → invalid_format', () => {\n    expect(validateIban('GB82').reason).toContain('invalid_format');\n    expect(validateIban('GB82WEST!234').reason).toContain('invalid_format');\n  });\n\n  it('unknown country → invalid', () => {\n    const r = validateIban('ZZ82WEST12345698765432');\n    expect(r.valid).toBe(false);\n    expect(r.reason).toBe('unknown_country');\n  });\n\n  it('wrong per-country length → invalid_length', () => {\n    const r = validateIban('NL91ABNA0417164300X'); // 19 chars, NL = 18\n    expect(r.valid).toBe(false);\n    expect(r.reason).toContain('invalid_length');\n  });\n});\n\n// ------------------------------------------------------------- VAT\ndescribe('VAT validation', () => {\n  it('format check: NL123456782B01 ok, DE ok', () => {\n    expect(checkVatFormat('NL123456782B01')).toMatchObject({ ok: true, countryCode: 'NL', vatNumber: '123456782B01' });\n    expect(checkVatFormat('DE136695976').ok).toBe(true);\n  });\n\n  it('format check: unknown member state & garbage rejected', () => {\n    expect(checkVatFormat('ZZ123456789').reason).toContain('unknown_eu_member_state');\n    expect(checkVatFormat('123').ok).toBe(false);\n  });\n\n  it('live VIES: valid response passes through with source + liveCheck true', async () => {\n    const fetchImpl = async () => jsonResponse({ countryCode: 'NL', vatNumber: '123456782B01', requestDate: '2026-11-26T20:08:04.336Z', valid: true });\n    const r = await validateVat('NL123456782B01', fetchImpl);\n    expect(r).toEqual({\n      valid: true, countryCode: 'NL', vatNumber: '123456782B01',\n      requestDate: '2026-11-26T20:08:04.336Z',\n      source: 'VIES (European Commission)', liveCheck: true,\n    });\n  });\n\n  it('live VIES: explicit invalid stays invalid', async () => {\n    const fetchImpl = async () => jsonResponse({ countryCode: 'NL', vatNumber: '123456782B01', requestDate: '2026-11-26T20:08:04.336Z', valid: false });\n    const r = await validateVat('NL123456782B01', fetchImpl);\n    expect(r.valid).toBe(false);\n    expect(r.liveCheck).toBe(true);\n  });\n\n  it('VIES down → fallback format-only with liveCheck false', async () => {\n    const fetchImpl = async () => { throw new Error('connection refused'); };\n    const r = await validateVat('NL123456782B01', fetchImpl);\n    expect(r.valid).toBe(false);\n    expect(r.liveCheck).toBe(false);\n    expect(r.source).toBe('VIES (European Commission)');\n    expect(r.reason).toContain('format-only');\n  });\n});\n\n// ------------------------------------------------------------- worker wiring\ndescribe('paid endpoints: 402 / 400 gating', () => {\n  it('bare probe on all 4 endpoints → 402 with payTo in header payload AND body', async () => {\n    const app = makeApp();\n    for (const path of ['/v1/ofac', '/v1/iban', '/v1/vat', '/v1/screen']) {\n      const res = await app.request(path);\n      expect(res.status).toBe(402);\n      const { payload, headerPayload } = await decode402Body(res);\n      expect(payload.accepts[0].payTo).toBe(SELLER);\n      expect(payload.accepts[0].amount).toBe(AMOUNT);\n      expect(headerPayload.accepts[0].payTo).toBe(SELLER);\n      expect(res.headers.get('payment-required')).toBeTruthy();\n    }\n  });\n\n  it('402 advertises price $0.004 / 4000 USDC on eip155:8453 with USDC asset', async () => {\n    const app = makeApp();\n    const res = await app.request('/v1/ofac');\n    const { payload } = await decode402Body(res);\n    expect(payload.accepts[0]).toMatchObject({\n      scheme: 'exact', network: 'eip155:8453', amount: AMOUNT, asset: USDC_BASE, payTo: SELLER,\n    });\n    expect(workerConfig.price).toBe(PRICE);\n  });\n\n  it('paid request (facilitator accepts) → 200 data', async () => {\n    const app = makeApp();\n    const res = await app.request('/v1/iban?iban=GB82 WEST 1234 5698 7654 32', {\n      headers: { 'x-payment': 'signed' },\n    });\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.valid).toBe(true);\n  });\n});\n\ndescribe('paid endpoint behavior', () => {\n  const paid = (path) => async (app) => (await app.request(path));\n\n  it('/v1/iban endpoint returns computed validation', async () => {\n    const app = makeApp();\n    const res = await app.request('/v1/iban?iban=NL91%20ABNA%200417%201643%2000');\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body).toMatchObject({ valid: true, country: 'NL', bankHint: 'ABNA0417' });\n  });\n\n  it('/v1/ofac: match → found true + matches + listDate + source', async () => {\n    const app = makeApp();\n    const res = await app.request('/v1/ofac?name=Saddam%20Hussein');\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.found).toBe(true);\n    expect(body.matches[0].name).toBe('AL-TIKRITI, Saddam Hussein');\n    expect(body.matches[0].score).toBeGreaterThanOrEqual(0.85);\n    expect(typeof body.listDate).toBe('string');\n    expect(body.source).toContain('OFAC');\n  });\n\n  it('/v1/ofac: no match → found false, empty matches', async () => {\n    const app = makeApp();\n    const res = await app.request('/v1/ofac?name=Nobody%20Here');\n    const body = await res.json();\n    expect(body.found).toBe(false);\n    expect(body.matches).toEqual([]);\n  });\n\n  it('OFAC dataset cached 24 h (separate cache from result cache)', async () => {\n    const app = makeApp();\n    await app.request('/v1/ofac?name=a'); await app.request('/v1/ofac?name=b');\n    await app.request('/v1/ofac?name=c'); await app.request('/v1/ofac?name=d');\n    expect(fetchCalls).toBe(1); // one CSV fetch despite 4 different queries\n  });\n\n  it('/v1/vat: live path via worker with VIES fixture', async () => {\n    const app = makeApp({\n      fetchImpl: async (url) => {\n        if (url.includes('sdn.csv')) return textResponse(OFAC_CSV);\n        if (url.includes('check-vat-number')) return jsonResponse({ countryCode: 'DE', vatNumber: '136695976', requestDate: '2026-11-26T20:08:09.909Z', valid: false });\n        throw new Error(`unexpected: ${url}`);\n      },\n    });\n    const res = await app.request('/v1/vat?vat=DE136695976');\n    expect(res.status).toBe(200);\n    expect(await res.json()).toMatchObject({\n      valid: false, countryCode: 'DE', liveCheck: true, source: 'VIES (European Commission)',\n    });\n  });\n\n  it('/v1/vat: VIES down → 200 with liveCheck false fallback', async () => {\n    const app = makeApp({\n      fetchImpl: async (url) => {\n        if (url.includes('check-vat-number')) return textResponse('gateway timeout', 504);\n        return textResponse(OFAC_CSV);\n      },\n    });\n    const res = await app.request('/v1/vat?vat=NL123456782B01');\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.liveCheck).toBe(false);\n    expect(body.valid).toBe(false);\n  });\n\n  it('/v1/screen verdicts: MATCH / REVIEW / CLEAR', async () => {\n    const app = makeApp();\n    const strong = await (await app.request('/v1/screen?name=AL-TIKRITI%2C%20Saddam%20Hussein')).json();\n    expect(strong.verdict).toBe('MATCH');\n    expect(strong.nameHint).toBe('AL TIKRITI SADDAM HUSSEIN');\n    // Craft a borderline case directly against screenVerdict.\n    const borderline = screenVerdict('Saddam Husein', { matches: [{ name: 'AL-TIKRITI, Saddam Hussein', program: 'IRAQ2', score: 0.86 }] });\n    expect(borderline.verdict).toBe('REVIEW');\n    const clear = screenVerdict('Totally Unrelated Person', { matches: [{ name: 'X', program: 'P', score: 0.42 }] });\n    expect(clear.verdict).toBe('CLEAR');\n    expect(clear.reasons.some((r) => r.includes('below threshold'))).toBe(true);\n    expect(strong.reasons.some((r) => r.includes('not identity verification'))).toBe(true);\n  });\n\n  it('query cap: > 200 chars → 400 (not 402)', async () => {\n    const app = makeApp();\n    const res = await app.request(`/v1/ofac?name=${'x'.repeat(201)}`);\n    expect(res.status).toBe(400);\n    expect(await res.json()).toMatchObject({ error: 'query_too_long' });\n  });\n\n  it('upstream error on /v1/ofac → clean 502', async () => {\n    const app = makeApp({ fetchImpl: async () => textResponse('nope', 503) });\n    const res = await app.request('/v1/ofac?name=test');\n    expect(res.status).toBe(502);\n    const body = await res.json();\n    expect(body.error).toBe('upstream_error');\n  });\n\n  it('result cache hit: second identical paid query reuses cache (X-Cache hit)', async () => {\n    const app = makeApp();\n    const r1 = await app.request('/v1/iban?iban=GB82 WEST 1234 5698 7654 32');\n    const r2 = await app.request('/v1/iban?iban=GB82 WEST 1234 5698 7654 32');\n    expect(r1.headers.get('X-Cache')).toBe('miss');\n    expect(r2.headers.get('X-Cache')).toBe('hit');\n  });\n});\n\n// ------------------------------------------------------------- free routes\ndescribe('free routes', () => {\n  it('/health', async () => {\n    const app = makeApp();\n    const res = await app.request('/health');\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    ex