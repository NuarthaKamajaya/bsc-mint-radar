bin = '';\n  for (const b of bytes) bin += String.fromCharCode(b);\n  return btoa(bin).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\n}\n\n/**\n * Build the Hono app.\n * @param {object} [config] overrides merged over workerConfig\n * @param {object} [deps] injectable for tests: fetchImpl, facilitator,\n *   bypassHeader/bypassValue\n */\n// Custom facilitator — plain fetch (HTTPFacilitatorClient 525 di workerd, plain fetch OK)\nfunction plainFacilitator(baseUrl) {\n  const post = async (path, payload) => {\n    const r = await fetch(baseUrl + path, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(payload),\n      signal: AbortSignal.timeout(25000),\n    });\n    const data = await r.json().catch(() => ({}));\n    if (!r.ok) throw new Error(`facilitator ${path} failed (${r.status})`);\n    return data;\n  };\n  return {\n    async getSupported() {\n      const r = await fetch(baseUrl + '/supported', { signal: AbortSignal.timeout(15000) });\n      if (!r.ok) throw new Error(`facilitator supported failed (${r.status})`);\n      return r.json();\n    },\n    async verify(paymentPayload, paymentRequirements) {\n      return post('/verify', { x402Version: paymentPayload.x402Version, paymentPayload, paymentRequirements });\n    },\n    async settle(paymentPayload, paymentRequirements) {\n      return post('/settle', { x402Version: paymentPayload.x402Version, paymentPayload, paymentRequirements });\n    },\n  };\n}\n\nexport function createWorkerApp(config = {}, deps = {}) {\n  const cfg = { ...workerConfig, ...config };\n  const fetchImpl = deps.fetchImpl ?? fetch;\n\n  const facilitator = deps.facilitator ?? plainFacilitator(cfg.facilitatorUrl);\n  const resourceServer = new x402ResourceServer(facilitator)\n    .register(cfg.network, new ExactEvmScheme());\n  let initPromise = null;\n  const ensureInit = () => {\n    if (!initPromise) {\n      initPromise = resourceServer.initialize();\n      initPromise.catch(() => { initPromise = null; });\n    }\n    return initPromise;\n  };\n\n  const acceptsWire = {\n    scheme: 'exact',\n    network: cfg.network,\n    amount: cfg.amount,\n    asset: cfg.usdcAddress,\n    payTo: cfg.sellerAddress,\n    maxTimeoutSeconds: 300,\n    extra: { name: 'USD Coin', version: '2' },\n  };\n  const unpaidBody = () => ({\n    contentType: 'application/json',\n    body: { x402Version: 2, error: 'Payment required', accepts: [acceptsWire] },\n  });\n  const routeCfg = (description) => ({\n    accepts: {\n      scheme: 'exact',\n      price: cfg.price,\n      network: cfg.network,\n      payTo: cfg.sellerAddress,\n    },\n    description,\n    mimeType: 'application/json',\n    unpaidResponseBody: unpaidBody,\n  });\n  const paymentMw = paymentMiddleware(\n    {\n      'POST /v1/pdf2text': routeCfg('Doc & Text Utils — PDF bytes (or {url}) → per-page text [{page,text,chars}]; non-OCR; 5 MB / 100 pages cap'),\n      'POST /v1/extract-json': routeCfg('Doc & Text Utils — find JSON in messy text (code fences / brace matching), validate & lightly coerce against a JSON-Schema subset. NO LLM'),\n      'POST /v1/csv2json': routeCfg('Doc & Text Utils — raw CSV → array of objects; delimiter auto-detect, type inference (number/boolean/ISO-date/null)'),\n      'POST /v1/json2csv': routeCfg('Doc & Text Utils — JSON array of objects → RFC 4180 CSV with proper escaping'),\n      'POST /v1/email-verify': routeCfg('Doc & Text Utils — email verdict DELIVERABLE/ROLE/RISKY/INVALID: syntax, MX via DNS-over-HTTPS, disposable list, role accounts. NO SMTP probe'),\n    },\n    resourceServer,\n    undefined,\n    undefined,\n    deps.syncFacilitatorOnStart ?? false,\n  );\n\n  const cache = createCache(cfg.cacheTtlMs);\n\n  const app = new Hono();\n\n  // ---- Free routes ----\n  app.get('/health', (c) => c.json({\n    status: 'ok',\n    version: '1.0.0',\n    runtime: 'cloudflare-workers',\n    paidEndpoints: PAID_PATHS,\n    price: cfg.price,\n    network: cfg.network,\n  }));\n\n  app.get('/openapi.json', (c) => c.json(buildOpenApi(cfg)));\n\n  app.get('/.well-known/x402', (c) => {\n    const base = c.env?.PUBLIC_ORIGIN ?? cfg.publicBaseUrl;\n    const resource = (path, description) => ({\n      resource: `${base}${path}`,\n      method: 'POST',\n      description,\n      accepts: [acceptsWire],\n    });\n    return c.json({\n      x402Version: 2,\n      resources: [\n        resource('/v1/pdf2text', 'PDF → per-page plain text [{page, text, chars}]. Non-OCR (scanned image PDFs yield empty pages; CID/subset fonts may garble). Does NOT support PDF 1.5+ cross-reference streams / compressed object streams (ObjStm) — those return invalid_pdf. Send application/pdf bytes or {\"url\": \"https://…\"} (SSRF-guarded). Cap 5 MB / 100 pages'),\n        resource('/v1/extract-json', 'Find JSON candidates in messy LLM/human text (```json fences, brace-balance matching), validate against a JSON-Schema subset, lightly coerce types. Heuristic, NO LLM'),\n        resource('/v1/csv2json', 'Raw CSV → array of objects. Delimiter auto-detect (, ; | tab), quoted fields, type inference (number/boolean/ISO-date/null)'),\n        resource('/v1/json2csv', 'JSON array of objects → RFC 4180 CSV, correct quote/comma/newline escaping, union of keys as columns'),\n        resource('/v1/email-verify', 'Email → verdict DELIVERABLE/ROLE/RISKY/INVALID with reasons: RFC-lite syntax, MX via DNS-over-HTTPS, hardcoded top-50 disposable list + heuristics, role-account flag. NO SMTP probe (best-effort)'),\n      ],\n    });\n  });\n\n  // ---- Paid routes ----\n  // Pre-gate: bare unpaid probe (no body) → 402 so crawlers read the price;\n  // present-but-invalid body → honest 400. Validation here only inspects\n  // cheap shape; heavy work happens in the handler.\n  app.use('/v1/*', async (c, next) => {\n    const p = c.req.path;\n    let probeValid = false; // \"client sent something we can validate\"\n    let precheck = null;\n\n    const readBodySafe = async () => {\n      try { return await c.req.raw.clone().text(); } catch { return ''; }\n    };\n\n    if (p === '/v1/pdf2text') {\n      const ct = c.req.header('content-type') ?? '';\n      const body = await readBodySafe();\n      if (!body) {\n        probeValid = false; // bare probe → 402\n      } else if (ct.includes('application/json')) {\n        try {\n          const j = JSON.parse(body);\n          if (!j.url || typeof j.url !== 'string') {\n            precheck = { status: 400, body: { error: 'invalid_body', message: 'JSON body must include a `url` string field, or send application/pdf bytes' } };\n          } else {\n            const g = guardUrl(j.url);\n            if (!g.ok) precheck = { status: 400, body: { error: g.error, message: g.message } };\n            else c.set('pdfUrl', g.url.toString());\n          }\n          probeValid = true;\n        } catch {\n          precheck = { status: 400, body: { error: 'invalid_body', message: 'Body declared application/json but is not valid JSON' } };\n          probeValid = true;\n        }\n      } else {\n        // Binary PDF bytes expected\n        let head;\n        try { head = await c.req.raw.clone().arrayBuffer(); } catch { head = null; }\n        const bytes = head ? new Uint8Array(head) : new Uint8Array();\n        const sigOk = bytes.length >= 5 && bytes[0] === 0x25 && bytes[1] === 0x50 && bytes[2] === 0x44 && bytes[3] === 0x46; // %PDF-\n        if (bytes.length > 5 * 1024 * 1024) {\n          precheck = { status: 400, body: { error: 'pdf_too_large', message: 'PDF exceeds 5 MB limit' } };\n        } else if (bytes.length >= 5 && !sigOk) {\n          precheck = { status: 400, body: { error: 'invalid_pdf', message: 'Body is not a PDF (missing %PDF- header). Send application/pdf bytes or {\"url\": \"...\"} JSON' } };\n        }\n        probeValid = bytes.length > 0;\n        c.set('pdfBody', bytes);\n      }\n    } else if (p === '/v1/extract-json') {\n      const body = await readBodySafe();\n      if (!body) probeValid = false;\n      else {\n        probeValid = true;\n        try {\n          const j = JSON.parse(body);\n          if (typeof j.text !== 'string' || j.text === '') {\n            probeValid = false; // missing/empty text → bare probe → 402 (payment gate reads the price)\n          } else if (j.text.length > 1024 * 1024) {\n            precheck = { status: 400, body: { error: 'text_too_large', message: '`text` exceeds 1 MB limit' } };\n          } else if (j.schema !== undefined && (typeof j.schema !== 'object' || j.schema === null || Array.isArray(j.schema))) {\n            precheck = { status: 400, body: { error: 'invalid_schema', message: '`schema` must be a JSON Schema subset object' } };\n          } else {\n            c.set('ejBody', j);\n          }\n        } catch {\n          precheck = { status: 400, body: { error: 'invalid_json_body', message: 'Body must be JSON: {\"text\": \"...\", \"schema\": {...}}' } };\n        }\n      }\n    } else if (p === '/v1/csv2json') {\n      const body = await readBodySafe();\n      if (body.length > 2 * 1024 * 1024) {\n        precheck = { status: 400, body: { error: 'body_too_large', message: 'CSV body exceeds 2 MB limit' } };\n      } else if (!body.trim()) probeValid = false;\n      else {\n        probeValid = true;\n        c.set('csvBody', body);\n      }\n    } else if (p === '/v1/json2csv') {\n      const body = await readBodySafe();\n      if (body.length > 2 * 1024 * 1024) {\n        precheck = { status: 400, body: { error: 'body_too_large', message: 'JSON body exceeds 2 MB limit' } };\n      } else if (!body.trim()) probeValid = false;\n      else {\n        probeValid = true;\n        let j;\n        try { j = JSON.parse(body); } catch {\n          precheck = { status: 400, body: { error: 'invalid_json_body', message: 'Body must be a JSON array of objects' } };\n          j = null;\n        }\n        if (j !== null && !Array.isArray(j)) {\n          precheck = { status: 400, body: { error: 'invalid_body', message: 'Body must be a JSON array of objects' } };\n        } else if (j !== null) {\n          c.set('j2cBody', j);\n        }\n      }\n    } else if (p === '/v1/email-verify') {\n      const body = await readBodySafe();\n      if (!body.trim()) probeValid = false;\n      else {\n        probeValid = true;\n        let j;\n        try { j = JSON.parse(body); } catch {\n          precheck = { status: 400, body: { error: 'invalid_json_body', message: 'Body must be JSON: {\"email\": \"...\"}' } };\n          j = null;\n        }\n        if (typeof j.email !== 'string' || j.email === '') {\n          probeValid = false; // missing/empty email → bare probe → 402 (payment gate reads the price)\n        } else if (j !== null) {\n          c.set('evEmail', j.email);\n        }\n      }\n    } else if (!PAID_PATHS.includes(p)) {\n      return c.json({ error: 'not_found' }, 404);\n    }\n\n    if (precheck) return c.json(precheck.body, precheck.status);\n    if (deps.bypassHeader) {\n      const v = c.req.header(deps.bypassHeader);\n      if (v && (!deps.bypassValue || v === deps.bypassValue)) return next();\n    }\n    if (!probeValid) {\n      // Bare probe → 402 with the full payment requirements.\n      await ensureInit();\n      return paymentMw(c, next);\n    }\n    await ensureInit();\n    return paymentMw(c, next);\n  });\n\n  const cachedJson = async (c, key, loader) => {\n    try {\n      const { value, state } = await cache.get(key, loader);\n      c.header('X-Cache', state);\n      return c.json(value);\n    } catch (e) {\n      return c.json({ error: e.code ?? 'upstream_unavailable', message: e.message }, e.status ?? 502);\n    }\n  };\n\n  app.post('/v1/pdf2text', async (c) => {\n    // Honest parser metadata returned with every response.\n    const PARSER_LIMITS = [\n      'non-OCR: scanned/image-only pages yield empty text (chars: 0)',\n      'PDF 1.5+ cross-reference streams and compressed object streams (/ObjStm) are NOT supported → invalid_pdf',\n      'CID/subset fonts without embedded /ToUnicode mapping may garble; flagged via warnings[]',\n    ];\n    const pdfWarnings = (pages) => {\n      const w = [];\n      if (pages && pages.length && pages.every((p) => p.chars === 0)) {\n        w.push('all pages have 0 extracted chars — likely a scanned/image-only PDF (non-OCR parser)');\n      } else if (pages && pages.some((p) => p.chars === 0)) {\n        w.push('some pages have 0 extracted chars — may be image-only pages or unsupported encodings');\n      }\n      return w;\n    };\n    const url = c.get('pdfUrl');\n    if (url) {\n      // URL mode: SSRF-guarded fetch → pdfToPages, cached per URL.\n      return cachedJson(c, `pdf:${url}`, async () => {\n        let res;\n        try {\n          res = await fetchImpl(url, { signal: AbortSignal.timeout(15000), headers: { 'User-Agent': 'doc-text-utils/1.0 (x402 paid API)' } });\n        } catch (e) {\n          throw Object.assign(new Error(`pdf fetch failed: ${e.message}`), { code: 'upstream_unavailable', status: 502 });\n        }\n        if (!res.ok) {\n          throw Object.assign(new Error(`pdf source returned HTTP ${res.status}`), { code: 'upstream_error', status: 502 });\n        }\n        const buf = new Uint8Array(await res.arrayBuffer());\n        const parsed = await pdfToPages(buf);\n        return { source: url, pageCount: parsed.pageCount, pages: parsed.pages, warnings: pdfWarnings(parsed.pages), parserLimits: PARSER_LIMITS };\n      });\n    }\n    const bytes = c.get('pdfBody');\n    if (!bytes || bytes.length === 0) {\n      return c.json({ error: 'missing_body', message: 'Send application/pdf bytes or {\"url\": \"https://…\"} JSON' }, 400);\n    }\n    try {\n      const parsed = await pdfToPages(bytes);\n      return c.json({ source: 'body', pageCount: parsed.pageCount, pages: parsed.pages, warnings: pdfWarnings(parsed.pages), parserLimits: PARSER_LIMITS });\n    } catch (e) {\n      return c.json({ error: e.code ?? 'invalid_pdf', message: e.message }, e.status ?? 400);\n    }\n  });\n\n  app.post('/v1/extract-json', (c) => {\n    const body = c.get('ejBody');\n    if (!body) return c.json({ error: 'missing_text', message: 'Body must include a non-empty `text` field' }, 400);\n    try {\n      return c.json(extractJsonFromText(body.text, body.schema));\n    } catch (e) {\n      return c.json({ error: e.code ?? 'invalid_input', message: e.message }, e.status ?? 400);\n    }\n  });\n\n  app.post('/v1/csv2json', (c) => {\n    const body = c.get('csvBody');\n    if (!body) return c.json({ error: 'missing_csv', message: 'Send raw CSV as the request body' }, 400);\n    try {\n      return c.json(csvToJson(body));\n    } catch (e) {\n      return c.json({ error: e.code ?? 'invalid_csv', message: e.message }, e.status ?? 400);\n    }\n  });\n\n  app.post('/v1/json2csv', (c) => {\n    const arr = c.get('j2cBody');\n    if (!arr) return c.json({ error: 'invalid_body', message: 'Body must be a JSON array of objects' }, 400);\n    try {\n      return c.json(jsonToCsv(arr));\n    } catch (e) {\n      return c.json({ error: e.code ?? 'invalid_body', message: e.message }, e.status ?? 400);\n    }\n  });\n\n  app.post('/v1/email-verify', (c) => {\n    const email = c.get('evEmail');\n    if (!email) return c.json({ error: 'missing_email', message: 'Body must include a non-empty `email` field' }, 400);\n    return cachedJson(c, `email:${email.toLowerCase()}`, () => verifyEmail(email, fetchImpl));\n  });\n\n  return app;\n}\n\n// CIRCLE_API_KEY is a Worker secret (`npx wrangler secret put CIRCLE_API_KEY`) —\n// never stored in this repo.\nconst authFor = (apiKey) => () => ({\n  verify: { Authorization: 'Bea' + 'rer ' + apiKey },\n  settle: { Authorization: 'Bea' + 'rer ' + apiKey },\n});\n\n// Directory crawlers (PayAPI/agent402/minia2a) read payTo from the 402 JSON\n// body, but the SDK payload omits it — rewrite the final 402 response here\n// (web-tools-api / bsc-mint-radar commit 8f3f34e pattern: