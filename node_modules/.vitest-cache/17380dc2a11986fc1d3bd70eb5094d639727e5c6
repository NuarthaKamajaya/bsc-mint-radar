/** RFC-lite syntax check (not full RFC 5322). */
function checkSyntax(email) {
  if (typeof email !== 'string' || email.length === 0 || email.length > 254) {
    return { ok: false, reason: 'email must be a non-empty string of ≤254 chars' };
  };
  const at = email.lastIndexOf('@');
  if (at <= 0 || at === email.length - 1) {
    return { ok: false, reason: 'missing or misplaced @' };
  };
  if (email.indexOf('@') !== at) return { ok: false, reason: 'multiple @ characters' };
  const [local, domain] = [email.slice(0, at), email.slice(at + 1)];
  if (local.length > 64) return { ok: false, reason: 'local part > 64 chars' };
  if (!/^[A-Za-z0-9!#$%&'*+/=?^_`{|}~.-]+$/.test(local)) {
    return { ok: false, reason: 'local part has invalid characters' };
  };
  if (local.startsWith('.') || local.endsWith('.') || local.includes('..')) {
    return { ok: false, reason: 'local part has leading/trailing/double dot' };
  };
  if (!/^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$/.test(domain)) {
    return { ok: false, reason: 'domain is not a valid hostname (labels + TLD)' };
  };
  const tld = domain.split('.').pop();
  if (!/^[A-Za-z]{2,}$/.test(tld)) return { ok: false, reason: 'TLD must be alphabetic (≥2 chars)' };
  return { ok: true, local, domain: domain.toLowerCase() };
}

/**
 * MX lookup via DNS-over-HTTPS (cloudflare-dns.com, application/dns-json).
 * @returns {{hasMx: boolean, mx: string[], error?: string}}
 */
async function lookupMx(domain, fetchImpl = fetch) {
  let data;
  try {
    data = await fetchBoundedJson(
      `https://cloudflare-dns.com/dns-query?name=${encodeURIComponent(domain)}&type=MX`,
      { headers: { accept: 'application/dns-json' } },
      'doh-mx',
      fetchImpl,
      false, // fixed allow-listed upstream — no SSRF guard needed
    );
  } catch (e) {
    return { hasMx: null, mx: [], error: `mx_lookup_failed: ${e.message}` };
  };
  if (data.Status !== 0) {
    // NXDOMAIN (3) → domain does not exist at all
    if (data.Status === 3) return { hasMx: false, mx: [], nxdomain: true };
    return { hasMx: null, mx: [], error: `dns status ${data.Status}` };
  };
  const answers = (data.Answer ?? []).filter((a) => a.type === 15);
  const mx = answers.map((a) => (a.data ?? '').replace(/^\d+\s+/, '').replace(/\.$/, '').toLowerCase());
  return { hasMx: mx.length > 0, mx };
};

/**
 * email-verify. Honest best-effort: syntax + domain + MX (DoH) + disposable
 * list/heuristics + role accounts. NO SMTP probe — "DELIVERABLE" means
 * "syntactically valid, domain exists and accepts mail (has MX)", not
 * "mailbox confirmed".
 */
async function verifyEmail(email, fetchImpl = fetch) {
  const reasons = [];
  const syn = checkSyntax(email);
  if (!syn.ok) {
    return { email: String(email ?? ''), verdict: 'INVALID', reasons: [syn.reason], checks: { syntax: false }, method: 'syntax + DNS MX (DoH) + heuristics — NO SMTP probe' };
  };
  const { local, domain } = syn;
  reasons.push('syntax_ok');

  const disposable = DISPOSABLE_DOMAINS.has(domain) ||
    (domain.split('.').slice(-2).join('.').length > 0 && DISPOSABLE_HEURISTIC_RE.test(domain));
  const isRole = ROLE_ACCOUNTS.has(local.toLowerCase());

  const mxRes = await lookupMx(domain, fetchImpl);
  if (mxRes.hasMx === null) {
    reasons.push(mxRes.error ?? 'mx_lookup_failed');
    return {
      email, domain, verdict: 'RISKY', reasons, mx: null,
      disposable, role: isRole,
      checks: { syntax: true, mx: 'unknown' },
      method: 'syntax + DNS MX (DoH) + heuristics — NO SMTP probe',
    };
  };
  if (!mxRes.hasMx) {
    reasons.push(mxRes.nxdomain ? `domain does not exist (NXDOMAIN): ${domain}` : `no MX records for ${domain} (domain cannot receive mail)`);
    return {
      email, domain, verdict: 'INVALID', reasons, mx: [], disposable, role: isRole,
      checks: { syntax: true, mx: false },
      method: 'syntax + DNS MX (DoH) + heuristics — NO SMTP probe',
    };
  };
  reasons.push(`mx_ok: ${mxRes.mx.slice(0, 3).join(', ')}${mxRes.mx.length > 3 ? ` +${mxRes.mx.length - 3} more` : ''}`);

  let verdict = 'DELIVERABLE';
  if (disposable) { verdict = 'RISKY'; reasons.push(`disposable/throwaway domain: ${domain}`); };
  if (isRole) {
    if (verdict === 'DELIVERABLE') verdict = 'ROLE';
    reasons.push(`role account: ${local.toLowerCase()}@ (shared inbox, not a personal mailbox)`);
  };
