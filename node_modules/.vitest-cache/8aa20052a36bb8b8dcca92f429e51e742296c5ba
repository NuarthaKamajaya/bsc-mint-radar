// Compliance tool implementations: OFAC SDN screening (fetch + parse + fuzzy
// match), IBAN validation (mod-97 checksum + per-country lengths), VAT
// validation (format + live VIES REST check with graceful fallback), and the
// combined screen verdict. Pure functions where possible; fetchImpl injected
// for tests.
const OFAC_SDN_URL = 'https://www.treasury.gov/ofac/downloads/sdn.csv';
const OFAC_SOURCE = 'OFAC SDN List (U.S. Department of the Treasury)';
const VIES_URL =
  'https://ec.europa.eu/taxation_customs/vies/rest-api/check-vat-number';
const VIES_SOURCE = 'VIES (European Commission)';

const FETCH_TIMEOUT_MS = 15000;
const MAX_CSV_BYTES = 30 * 1024 * 1024; // OFAC SDN.CSV is ~5.8 MB today

/**
 * Fetch with timeout + size cap; returns text. Throws Error with .code on
 * failure so the route can map to 502.
 */
async function fetchBoundedText(url, fetchImpl, { maxBytes = MAX_CSV_BYTES, headers = undefined } = {}) {
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), FETCH_TIMEOUT_MS);
  let res;
  try {
    res = await fetchImpl(url, {
      signal: ctrl.signal,
      headers: headers ?? { 'user-agent': 'compliance-api/1.0 (x402 paid API)' },
      redirect: 'follow',
    });
  } catch (e) {
    throw Object.assign(new Error(`upstream fetch failed: ${e.message}`), {
      code: 'upstream_unavailable', status: 502,
    });
  } finally {
    clearTimeout(timer);
  };
  if (!res.ok) {
    throw Object.assign(new Error(`upstream HTTP ${res.status}`), {
      code: 'upstream_error', status: 502,
    });
  };
  const text = await res.text();
  if (text.length > maxBytes) {
    throw Object.assign(new Error('upstream response too large'), {
      code: 'upstream_too_large', status: 502,
    });
  };
  return text;
};

/** Fetch JSON with the same timeout/error discipline. */
async function fetchBoundedJson(url, fetchImpl, init = {}) {
  const text = await fetchBoundedText(url, fetchImpl, {
    maxBytes: init.maxBytes ?? 1024 * 1024,
    headers: init.headers,
  });
  try {
    return JSON.parse(text);
  } catch {
    throw Object.assign(new Error('upstream returned non-JSON'), {
      code: 'upstream_error', status: 502,
    });
  }
};

// --------------------------------------------------------------- OFAC parse
/** Minimal RFC-4180-ish CSV row parser (handles quoted fields with commas). */
function parseCsvRows(text) {
  const rows = [];
  let row = [];
  let field = '';
  let inQuotes = false;
  for (let i = 0; i < text.length; i++) {
    const ch = text[i];
    if (inQuotes) {
      if (ch === '"') {
        if (text[i + 1] === '"') { field += '"'; i++; } else inQuotes = false;
      } else field += ch;
    } else if (ch === '"') inQuotes = true;
    else if (ch === ',') { row.push(field); field = ''; }
    else if (ch === '\n' || ch === '\r') {
      if (ch === '\r' && text[i + 1] === '\n') i++;
      row.push(field); field = '';
      if (row.length > 1 || row[0] !== '') rows.push(row);
      row = [];
    } else field += ch;
  };
  row.push(field);
  if (row.length > 1 || row[0] !== '') rows.push(row);
  return rows;
};

const DASH = '-0-';

/** Extract a.k.a. aliases from the Remarks field: a.k.a. 'X'; f.k.a. 'Y'. */
function extractAliases(remarks) {
  if (!remarks) return [];
  const out = [];
  const re = /[af]\.k\.a\.\s*(?:'([^']+)'|"([^"]+)"|([A-Za-z0-9 .,'\-]+?)(?=[;.]|$))/gi;
  let m;
  while ((m = re.exec(remarks)) !== null) {
    const alias = (m[1] ?? m[2] ?? m[3] ?? '').trim();
    if (alias.length > 1) out.push(alias);
  };
  return out;
};

/**
 * Parse SDN.CSV rows → entries {name, type, program, aliases}.
 * Columns: ent_num, SDN_Name, SDN_Type, Program, Title, Call_Sign, Vess_type,
 * Tonnage, GRT, Vess_flag, Vess_owner, Remarks (dashes '-0-' = empty).
 */
function parseSdnCsv(text) {
  const rows = parseCsvRows(text);
  const entries = [];
  for (const r of rows) {
    const name = (r[1] ?? '').trim();
    if (!name || name === DASH) continue;
    const type = (r[2] ?? '').trim() === DASH ? '' : (r[2] ?? '').trim();
    const program = (r[3] ?? '').trim() === DASH ? '' : (r[3] ?? '').trim();
    const remarks = (r[11] ?? '').trim() === DASH ? '' : (r[11] ?? '').trim();
    const aliases = extractAliases(remarks);
    entries.push({ name, type, program, aliases });
  };
  return entries;
};

// -------------------------------------------------------------- fuzzy match
function normalizeName(s) {
  return (s ?? '')
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .toUpperCase()
    .replace(/[^A-Z0-9 ]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
};

function levenshtein(a, b) {
  if (a === b) return 0;
  if (!a.length) return b.length;
  if (!b.length) return a.length;
  let prev = new Array(b.length + 1);
  for (let j = 0; j <= b.length; j++) prev[j] = j;
  for (let i = 1; i <= a.length; i++) {
    const cur = [i];
    for (let j = 1; j <= b.length; j++) {
      cur[j] = Math.min(
        prev[j] + 1,
        cur[j - 1] + 1,
        prev[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1),
      );
    };
    prev = cur;
  };
  return prev[b.length];
};

/** Normalized Levenshtein similarity in [0,1]. */
function normalizedSimilarity(a, b) {
  if (!a || !b) return 0;
  const max = Math.max(a.length, b.length);
  if (!max) return 0;
  return 1 - levenshtein(a, b) / max;
};

/** Token-subset score: fraction of query tokens present in target. */
function tokenSubsetScore(queryNorm, targetNorm) {
  const q = queryNorm.split(' ').filter(Boolean);
  if (!q.length) return 0;
  const t = ' ' + targetNorm.split(' ').filter(Boolean).join(' ') + ' ';
  let hit = 0;
  for (const tok of q) if (t.includes(` ${tok} `)) hit++;
  return hit / q.length;
};

function scoreAgainst(queryNorm, nameNorm) {
  const lev = normalizedSimilarity(queryNorm, nameNorm);
  const tok = tokenSubsetScore(queryNorm, nameNorm);
  return Math.max(lev, tok);
}

const MATCH_THRESHOLD = 0.85;
const MATCH_THRESHOLD_STRONG = 0.9;

/**
 * Fuzzy screen a name against parsed OFAC entries (incl. aliases).
 * Returns top matches sorted by score (desc), score >= 0.4.
 */
function screenName(query, entries, { limit = 5 } = {}) {
  const q = normalizeName(query);
  if (!q) return [];
  const results = [];
  for (const e of entries) {
    let best = scoreAgainst(q, normalizeName(e.name));
    let bestSource = e.name;
    for (const alias of e.aliases ?? []) {
      const s = scoreAgainst(q, normalizeName(alias));
      if (s > best) { best = s; bestSource = alias; }
    };
    if (best >= 0.4) {
      results.push({ entry: e, matchedName: bestSource, score: Math.round(best * 1000) / 1000 });
    }
  };
  results.sort((a, b) => b.score - a.score);
  return results.slice(0, limit).map((r) => ({
    name: r.entry.name,
    type: r.entry.type || 'unknown',
    program: r.entry.program || 'unknown',
    score: r.score,
  }));
};

// -------------------------------------------------------------- IBAN
// IBAN registry: country → total length (BBAN + 2-letter + 2 check digits).
// Lengths per ISO 13616 registry (SWIFT).
const IBAN_LENGTHS = {
  AD: 24, AE: 23, AL: 28, AT: 20, AZ: 28, BA: 20, BE: 16, BG: 22, BH: 22,
  BI: 27, BR: 29, BY: 28, CH: 21, CR: 22, CY: 28, CZ: 24, DE: 22, DJ: 27,
  DK: 18, DO: 28, EE: 20, EG: 29, ES: 24, FI: 18, FK: 18, FO: 18, FR: 27,
  GB: 22, GE: 22, GI: 23, GL: 18, GR: 27, GT: 28, HR: 21, HU: 28, IE: 22,
  IL: 23, IQ: 23, IS: 26, IT: 27, JO: 30, KW: 30, KZ: 20, LB: 28, LC: 32,
  LI: 21, LT: 20, LU: 20, LV: 21, LY: 25, MC: 27, MD: 24, ME: 22, MK: 19,
  MN: 20, MR: 27, MT: 31, MU: 30, NI: 28, NL: 18, NO: 15, OM: 23, PK: 24,
  PL: 28, PS: 29, PT: 25, QA: 29, RO: 24, RS: 22, RU: 33, SA: 24, SC: 31,
  SD: 18, SE: 24, SI: 19, SK: 24, SM: 27, SO: 23, ST: 25, SV: 28, TL: 23,
  TN: 24, TR: 26, UA: 29, VA: 22, VG: 24, XK: 20,
  // Non-EU/ISO-13616-adopting but commonly routed:
  AO: 25, BF: 27, BJ: 28, CF: 27, CG: 27, CI: 28, CM: 27, CV: 25, DZ: 24,
  GA: 27, GQ: 27, GW: 25, HN: 28, IR: 26, KM: 27, MA: 28, MG: 27, ML: 28,
  MZ: 25, NE: 28, PG: 30, SN: 28, TD: 27, TG: 28,
};

const IBAN_FORMAT = /^([A-Z]{2})(\d{2})([A-Z0-9]{11,30})$/;

/**
 * Validate an IBAN string: strip spaces, uppercase, structure + mod-97 checksum
 * (ISO 13616) + per-country length. Pure computation.
 * Returns { valid, country, bankHint, reason }.
 */
function validateIban(raw) {
  const stripped = (raw ?? '').replace(/\s+/g, '').toUpperCase();
  if (!stripped) {
    return { valid: false, country: null, bankHint: null, reason: 'empty_input' };
  };
  const m = IBAN_FORMAT.exec(stripped);
  if (!m) {
    return {
      valid: false, country: null, bankHint: null,
      reason: 'invalid_format — expected ^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$ after stripping spaces',
    };
  };
  const country = m[1];
  const expectedLen = IBAN_LENGTHS[country];
  if (!expectedLen) {
    return { valid: false, country, bankHint: null, reason: 'unknown_country' };
  };
  if (stripped.length !== expectedLen) {
    return {
      valid: false, country, bankHint: null,
      reason: `invalid_length — ${country} IBANs are ${expectedLen} chars, got ${stripped.length}`,
    };
  };
  // mod-97: move first 4 chars to the end, letters → 10..35, big-int mod.
  const rearranged = stripped.slice(4) + stripped.slice(0, 4);
  let num = '';
  for (const ch of rearranged) {
    const c = ch.charCodeAt(0);
    num += c >= 65 && c <= 90 ? String(c - 55) : ch;
  };
  const mod97 = BigInt(num) % 97n;
  const bankHint = stripped.slice(4, 12); // BBAN starts with bank/branch code
  if (mod97 !== 1n) {
    return { valid: false, country, bankHint, reason: 'checksum_failed (mod-97)' };
  };
  return { valid: true, country, bankHint, reason: 'format + mod-97 checksum valid' };
};

// -------------------------------------------------------------- VAT
// Generic EU VAT format: 2-letter country + 5..15 alphanumerics (plus rare
// '+' '.' '-' chars in ES format suffix). Per-country regex would be nicer;
// this is a sanity gate before the live VIES call.
const VAT_FORMAT = /^([A-Z]{2})([A-Z0-9+\-.\s]{5,15})$/;
const EU_COUNTRIES = new Set([
  'AT', 'BE', 'BG', 'CY', 'CZ', 'DE', 'DK', 'EE', 'ES', 'FI', 'FR', 'GR',
  'HR', 'HU', 'IE', 'IT', 'LT', 'LU', 'LV', 'MT', 'NL', 'PL', 'PT', 'RO',
  'SE', 'SI', 'SK', 'XI',
]);

/** Parse & format-check a VAT number like "NL123456782B01". */
function checkVatFormat(raw) {
  const cleaned = (raw ?? '').replace(/\s+/g, '').toUpperCase();
  const m = VAT_FORMAT.exec(cleaned);
  if (!m) return { ok: false, countryCode: null, vatNumber: null, reason: 'invalid_format' };
  const countryCode = m[1];
  if (!EU_COUNTRIES.has(countryCode)) {
    return { ok: false, countryCode, vatNumber: m[2], reason: `unknown_eu_member_state: ${countryCode}` };
  };
  return { ok: true, countryCode, vatNumber: m[2], reason: 'format ok' };
};

/**
 * Validate VAT: format check + live VIES REST check (POST check-vat-number).
 * VIES down / non-JSON / HTTP error → fall back to format-only with
 * liveCheck: false and valid=false (format pass alone is NOT proof of validity).
 */
async function validateVat(raw, fetchImpl) {
  const fmt = checkVatFormat(raw);
  if (!fmt.ok) {
    return {
      valid: false, countryCode: fmt.countryCode, vatNumber: fmt.vatNumber,
      requestDate: null, source: VIES_SOURCE, liveCheck: false,
      reason: fmt.reason,
    };
  };
  let data;
  try {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), FETCH_TIMEOUT_MS);
    let res;
    try {
      res = await fetchImpl(VIES_URL, {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'user-agent': 'compliance-api/1.0 (x402 paid API)' },
        body: JSON.stringify({ countryCode: fmt.countryCode, vatNumber: fmt.vatNumber }),
        signal: ctrl.signal,
      });
    } finally {
      clearTimeout(timer);
    };
    if (!res.ok) throw new Error(`VIES HTTP ${res.status}`);
    data = await res.json();
  } catch (e) {
    return {
      valid: false, countryCode: fmt.countryCode, vatNumber: fmt.vatNumber,
      requestDate: null, source: VIES_SOURCE, liveCheck: false,
      reason: `VIES unavailable (${e.message}); format-only check passed — validity unproven`,
    };
  };
  return {
    valid: data.valid === true,
    countryCode: data.countryCode ?? fmt.countryCode,
    vatNumber: data.vatNumber ?? fmt.vatNumber,
    requestDate: data.requestDate ?? null,
    source: VIES_SOURCE,
    liveCheck: true,
  };
};

// -------------------------------------------------------------- screen
/**
 * Combined screen verdict from OFAC score alone (no PEP list — explicit scope).
 * Returns { verdict: CLEAR | MATCH | REVIEW, reasons: [...], matches, nameHint }.
 */
function screenVerdict(query, ofacResult) {
  const nameHint = normalizeName(query);
  const reasons = [];
  const top = ofacResult.matches?.[0];
  let verdict = 'CLEAR';
  if (top && top.score >= MATCH_THRESHOLD_STRONG) {
    verdict = 'MATCH';
    reasons.push(`ofac: name similarity ${(top.score).toFixed(3)} ≥ ${MATCH_THRESHOLD_STRONG} against "${top.name}" (${top.program})`);
  } else if (top && top.score >= MATCH_THRESHOLD) {
    verdict = 'REVIEW';
    reasons.push(`ofac: borderline similarity ${(top.score).toFixed(3)} ≥ ${MATCH_THRESHOLD} against "${top.name}" (${top.program}) — manual review advised`);
  } else if (top) {
    reasons.push(`ofac: best similarity ${(top.score).toFixed(3)} below threshold ${MATCH_THRESHOLD}`);
  } else {
    reasons.push(`ofac: no plausible matches (similarity >= 0.4)`);
  };
  reasons.push('screening is fuzzy name matching only — not identity verification, not a KYC decision');
  return { verdict, reasons, matches: ofacResult.matches ?? [], nameHint };
}

