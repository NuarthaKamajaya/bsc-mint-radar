// OpenAPI 3.1 document for agent discovery (paid endpoints carry x-payment-info).
function buildOpenApi(config) {
  const price = config.price ?? '$0.004';
  const pay = (desc) => ({
    price,
    protocol: 'x402',
    network: config.network ?? 'eip155:8453',
    asset: 'USDC',
    payTo: config.sellerAddress,
    description: desc,
  });
  const paidResponses = {
    200: { description: 'Data payload (JSON)' },
    400: { description: 'Present-but-invalid query parameter (missing, empty, > 200 chars)' },
    402: { description: 'Payment required (x402 v2, USDC on Base)' },
    502: { description: 'Upstream unavailable' },
  };
  return {
    openapi: '3.1.0',
    info: {
      title: 'Compliance & Financial Validation API',
      version: '1.0.0',
      description:
        'Compliance checks as a paid API: OFAC SDN sanctions screening (fuzzy name match, dataset cached 24 h), IBAN validation (mod-97 checksum), EU VAT validation (live VIES REST), combined CLEAR/MATCH/REVIEW verdict. Paid per request in USDC on Base via x402 v2. NOT a KYC service and no legal guarantee — see README.',
      'x-x402-price': price,
    },
    servers: [{ url: config.publicBaseUrl ?? 'https://compliance-api.kamajaya-agents.workers.dev' }],
    paths: {
      '/v1/ofac': {
        get: {
          operationId: 'ofacScreen',
          summary: 'OFAC SDN sanctions screening (fuzzy name match)',
          description: 'Screens a name against the OFAC SDN list (U.S. Treasury SDN.CSV, fetched on demand and cached 24 h): normalized Levenshtein + token-subset similarity over names and a.k.a./f.k.a. aliases. found=true when top similarity ≥ 0.85. Fuzzy match, not identity verification. Paid: x402 USDC on Base.',
          parameters: [
            { name: 'name', in: 'query', required: true, schema: { type: 'string', maxLength: 200 }, description: 'Name to screen, e.g. "Saddam Hussein"' },
          ],
          'x-payment-info': pay('OFAC SDN sanctions screening'),
          responses: paidResponses,
        },
      },
      '/v1/iban': {
        get: {
          operationId: 'ibanValidate',
          summary: 'IBAN validation (format + mod-97 checksum + country length)',
          description: 'Validates an IBAN: strips spaces, checks the ISO 13616 structure, recomputes the mod-97 checksum locally (no network), and enforces per-country lengths for 80+ countries. Returns valid, country, bankHint (BBAN bank/branch slice), reason. Paid: x402 USDC on Base.',
          parameters: [
            { name: 'iban', in: 'query', required: true, schema: { type: 'string', maxLength: 200 }, description: 'IBAN, e.g. "GB82 WEST 1234 5698 7654 32" (spaces ok)' },
          ],
          'x-payment-info': pay('IBAN validation'),
          responses: paidResponses,
        },
      },
      '/v1/vat': {
        get: {
          operationId: 'vatValidate',
          summary: 'EU VAT validation (format + live VIES check)',
          description: 'Validates an EU VAT number: format check + live VIES REST call (ec.europa.eu check-vat-number, European Commission). When VIES is unreachable, falls back to format-only with liveCheck:false (valid=false — format alone proves nothing). Paid: x402 USDC on Base.',
          parameters: [
            { name: 'vat', in: 'query', required: true, schema: { type: 'string', maxLength: 200 }, description: 'VAT number incl. country prefix, e.g. "NL123456782B01"' },
          ],
          'x-payment-info': pay('EU VAT validation via VIES'),
          responses: paidResponses,
        },
      },
      '/v1/screen': {
        get: {
          operationId: 'screenVerdict',
          summary: 'Combined screening verdict CLEAR/MATCH/REVIEW',
          description: 'Runs the OFAC screening and returns a verdict: MATCH (similarity ≥ 0.90), REVIEW (≥ 0.85), else CLEAR, with reasons and a normalized-name hint. Name-similarity only — not identity verification, no PEP list, no KYC decision. Paid: x402 USDC on Base.',
          parameters: [
            { name: 'name', in: 'query', required: true, schema: { type: 'string', maxLength: 200 }, description: 'Name to screen' },
          ],
          'x-payment-info': pay('Combined screening verdict'),
          responses: paidResponses,
        },
      },
    },
  };
}

