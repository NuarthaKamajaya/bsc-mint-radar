 (base64url JSON, authoritative per x402 v2)\n    const headers = new Headers(response.headers);\n    const hdr = headers.get('payment-required');\n    if (hdr) {\n      try {\n        const decoded = JSON.parse(atob(hdr.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat(-hdr.length % 4 || 0)));\n        let changed = false;\n        for (const a of decoded?.accepts ?? []) {\n          if (!a.payTo) { a.payTo = sellerAddress; changed = true; }\n        }\n        if (changed) {\n          const b64 = btoa(JSON.stringify(decoded)).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\n          headers.set('payment-required', b64);\n        }\n      } catch { /* header stays as-is */ }\n    }\n    // 2) JSON body mirror\n    const payload = await response.json();\n    let changed = false;\n    for (const a of payload?.accepts ?? []) {\n      if (!a.payTo) { a.payTo = sellerAddress; changed = true; }\n    }\n    if (!changed) return response;\n    headers.delete('content-length');\n    return new Response(JSON.stringify(payload), { status: 402, headers });\n  } catch {\n    return response;\n  }\n};\n\nexport default {\n  async fetch(request, env, ctx) {\n    const app = createWorkerApp({\n      sellerAddress: env.SELLER_ADDRESS || undefined,\n      facilitatorUrl: env.FACILITATOR_URL || undefined,\n      publicBaseUrl: env.PUBLIC_BASE_URL || undefined,\n    }, {\n      facilitatorAuth: env.CIRCLE_API_KEY ? authFor(env.CIRCLE_API_KEY) : undefined,\n    });\n    const seller = env.SELLER_ADDRESS || '0xAe9ad223a1D4e9ADecFd3BD8363f1b8Ea4e0d512';\n    return withPayToInBody(await app.fetch(request, env, ctx), seller);\n  },\n};\n"],"names":[],"mappings":"AAAA,CAAA;;;AAWA;AACA;AACA;AACA;AACA;AACA;AACA;AAjBA,CAAC,CAAC,CAAC,UAAU,CAAC,MAAM,CAAC,KAAK,CAAC,CAAC,MAAM,CAAC,CAAC,OAAO,CAAC,CAAC;AAC7C,CAAC,CAAC,CAAC,IAAI,CAAC,GAAG,CAAC,OAAO,CAAC,EAAE,CAAC,GAAG,CAAC,OAAO,CAAC,OAAO,CAAC,CAAC,GAAG,CAAC,MAAM,CAAC,GAAG,CAAC,CAAC,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;AACrE,CAAC,CAAC,CAAC,