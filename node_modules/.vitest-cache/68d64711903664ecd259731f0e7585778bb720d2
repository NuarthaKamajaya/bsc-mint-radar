// OpenAPI 3.1 document for agent discovery (paid endpoints carry x-payment-info).
function buildOpenApi(config) {
  const price = config.price ?? '$0.002';
  const pay = (desc) => ({
    price,
    protocol: 'x402',
    network: config.network ?? 'eip155:8453',
    asset: 'USDC',
    payTo: config.sellerAddress,
    description: desc,
  });
  const paidResponses = {
    200: { description: 'Data payload (JSON)' },
    400: { description: 'Present-but-invalid body (incl. SSRF-blocked targets, non-PDF bytes)' },
    402: { description: 'Payment required (x402 v2, USDC on Base)' },
    502: { description: 'Upstream unavailable' },
  };
  return {
    openapi: '3.1.0',
    info: {
      title: 'Doc & Text Utils API',
      version: '1.0.0',
      description:
        'Document & text utilities: PDF → per-page text (non-OCR), heuristic JSON extraction from messy text (no LLM), CSV ⇄ JSON conversion, and best-effort email verification (syntax + DNS MX, no SMTP). Paid per request in USDC on Base via x402 v2. Cached 10 minutes where applicable, keyless.',
      'x-x402-price': price,
    },
    servers: [{ url: config.publicBaseUrl ?? 'https://doc-text-utils.kamajaya-agents.workers.dev' }],
    paths: {
      '/v1/pdf2text': {
        post: {
          operationId: 'pdf2text',
          summary: 'PDF → per-page plain text (non-OCR)',
          description: 'Parses a PDF and returns [{page, text, chars}] per page. Zero-dependency text extractor: walks the page tree, inflates FlateDecode content streams, extracts Tj/TJ text operators. Non-OCR — scanned/image PDFs yield empty pages. Send application/pdf bytes (≤5 MB, ≤100 pages) or {"url": "https://…"} to fetch a public PDF (SSRF-guarded, 15 s timeout, cached 10 min). Paid: x402 USDC on Base.',
          requestBody: {
            required: true,
            content: {
              'application/pdf': { schema: { type: 'string', format: 'binary' } },
              'application/json': { schema: { type: 'object', properties: { url: { type: 'string' } }, required: ['url'] } },
            },
          },
          'x-payment-info': pay('PDF → per-page text (non-OCR)'),
          responses: paidResponses,
        },
      },
      '/v1/extract-json': {
        post: {
          operationId: 'extractJson',
          summary: 'Extract & validate JSON from messy text against a schema subset (no LLM)',
          description: 'Finds JSON candidates in text (```json code fences, then brace-balance matching honoring strings/escapes), parses the best one against a JSON Schema subset (type string/number/boolean/array/object, enum, required, properties), lightly coerces types ("5" → 5, "true" → true) and reports {data, missingRequired, coerced, confidence}. Pure heuristics — NO LLM call.',
          requestBody: {
            required: true,
            content: { 'application/json': { schema: { type: 'object', properties: { text: { type: 'string' }, schema: { type: 'object' } }, required: ['text'] } } },
          },
          'x-payment-info': pay('Heuristic JSON extraction + schema validation (no LLM)'),
          responses: paidResponses,
        },
      },
      '/v1/csv2json': {
        post: {
          operationId: 'csv2json',
          summary: 'Raw CSV → array of objects (delimiter auto-detect + type inference)',
          description: 'Parses a raw CSV body. Delimiter auto-detected (comma / semicolon / pipe / tab) from unquoted header characters; RFC 4180 quoted fields and "" escapes supported. First row = header. Cell type inference: number, boolean, ISO-date (kept as string), null tokens ("", null, -) → null. Returns {data, delimiter, rowCount}. Paid: x402 USDC on Base.',
          requestBody: { required: true, content: { 'text/csv': { schema: { type: 'string' } } } },
          'x-payment-info': pay('CSV → JSON with delimiter auto-detect and type inference'),
          responses: paidResponses,
        },
      },
      '/v1/json2csv': {
        post: {
          operationId: 'json2csv',
          summary: 'JSON array of objects → RFC 4180 CSV',
          description: 'Converts a JSON array of objects to CSV. Columns = union of keys in first-seen order; nested objects/arrays are JSON-stringified; quotes/commas/newlines escaped per RFC 4180; null → empty cell. Returns {csv, columns, rowCount}. Paid: x402 USDC on Base.',
          requestBody: { required: true, content: { 'application/json': { schema: { type: 'array', items: { type: 'object' } } } } },
          'x-payment-info': pay('JSON array → RFC 4180 CSV'),
          responses: paidResponses,
        },
      },
      '/v1/email-verify': {
        post: {
          operationId: 'emailVerify',
          summary: 'Email verdict DELIVERABLE/ROLE/RISKY/INVALID (no SMTP — best-effort)',
          description: 'Best-effort email verification WITHOUT SMTP probing: RFC-lite syntax check, domain hostname validation, MX lookup via DNS-over-HTTPS (cloudflare-dns.com), hardcoded top-50 disposable-domain list + name heuristics, role-account flag (info@, admin@, support@, …). DELIVERABLE means "valid syntax + domain accepts mail (MX)" — not a confirmed mailbox. Returns {email, domain, verdict, reasons, mx, disposable, role}. Cached 10 min. Paid: x402 USDC on Base.',
          requestBody: {
            required: true,
            content: { 'application/json': { schema: { type: 'object', properties: { email: { type: 'string' } }, required: ['email'] } } },
          },
          'x-payment-info': pay('Email syntax + MX (DoH) + disposable/role heuristics (no SMTP)'),
          responses: paidResponses,
        },
      },
    },
  };
}

